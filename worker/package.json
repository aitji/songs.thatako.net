{
    "name": "morning-song-queue-worker",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "wrangler dev",
        "deploy": "wrangler deploy",
        "db:create": "wrangler d1 create morning-song-queue",
        "db:migrate": "wrangler d1 execute morning-song-queue --file=./schema.sql",
        "db:migrate:remote": "wrangler d1 execute morning-song-queue --remote --file=./schema.sql",
        "secrets": "echo 'run: wrangler secret put ADMIN_PASSWORD   &&   wrangler secret put SESSION_SECRET'",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20260702.1",
        "typescript": "^5.9.3",
        "wrangler": "^3.114.17"
    },
    "allowScripts": {
        "esbuild@0.17.19": true,
        "sharp@0.33.5": true,
        "workerd@1.20250718.0": true
    }
}