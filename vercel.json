{
    "outputDirectory": "public",
    "routes": [
        {
            "handle": "filesystem"
        },
        {
            "src": "/pr",
            "dest": "/admin.html",
            "headers": {
                "x-vercel-regex-flags": "i"
            }
        },
        {
            "src": "/(.*)",
            "status": 404,
            "dest": "/404.html"
        }
    ]
}